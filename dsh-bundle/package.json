{
  "name": "@local/ppt-agent-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ppt-agent：把 PowerPoint 控制台挂进 DSH（MCP 工具 + 输入框下方的一行状态条）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
